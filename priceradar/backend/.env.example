# Server
PORT=5000

# Anthropic API (for review summaries + suggestions)
ANTHROPIC_API_KEY=your_key_here

# Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/priceradar

# Redis (cache + job queue)
REDIS_URL=redis://localhost:6379

# Scraper behavior
SCRAPE_HEADLESS=true
SCRAPE_TIMEOUT_MS=15000
SCRAPE_SEARCH_TIMEOUT_MS=12000
BREAKER_THRESHOLD=5
BREAKER_OPEN_MS=900000
